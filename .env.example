# ================================================== #
# EXPLITA DEPLOY - ENVIRONMENT CONFIGURATION (.env)  #
# ================================================== #
#
# IMPORTANT:
# Some configuration values below are IMMUTABLE once your server is initialized
# and applications/databases have been created. Changing them later will corrupt
# data, break decryption of secrets, or orphan existing applications.
#
# Review the "IMMUTABLE VALUES" section carefully before first run!
# ==================================================================

# ----------------------------------------------------------- #
# 1. IMMUTABLE VALUES - DO NOT CHANGE ONCE APPS ARE CREATED!
# ----------------------------------------------------------- #

# Master encryption key for sensitive data at rest (AES-256-GCM).
# Used to encrypt app secrets, PostgreSQL database credentials, and Redis passwords.
# ⚠️ NEVER CHANGE THIS once apps or databases exist:
#    If changed, existing environment variables, database URLs, and Redis URLs
#    CANNOT be decrypted, causing deployments, restarts, and rollbacks to fail.
# Generate once during initial setup using: openssl rand -hex 32
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Base storage directory for apps, builds, and Caddy configurations.
# ⚠️ NEVER CHANGE THIS once apps exist:
#    Existing application source files, deployment builds, and routing configs
#    are stored under this path. Changing it orphans all existing app files.
DATA_DIR=/var/lib/explita

# Managed PostgreSQL (Control Plane & App databases)
# ⚠️ Physical volume on the host where PostgreSQL stores all tables. Defaults to DATA_DIR/postgres.
# POSTGRES_DATA_DIR=/var/lib/explita/postgres
POSTGRES_ROOT_PASSWORD=change-me-to-a-secure-db-password
# POSTGRES_PORT=5432

# (Optional) External PostgreSQL override for Deploy control plane (e.g. Supabase, AWS RDS, Neon)
# If provided, Deploy control plane uses this external database; managed app databases still lazy-load on demand.
# DATABASE_URL=postgresql://user:password@localhost:5432/explita_deploy

# Managed MariaDB / MySQL (App databases, lazy-loaded on demand)
# ⚠️ Physical volume on the host where MariaDB stores app databases. Defaults to DATA_DIR/mariadb.
# MYSQL_DATA_DIR=/var/lib/explita/mariadb
# MYSQL_ROOT_PASSWORD=change-me-to-a-secure-db-password
# MYSQL_PORT=3306

# Managed Redis Storage & Credentials (if REDIS_ENABLED=true)
# ⚠️ NEVER CHANGE REDIS_DATA_DIR or REDIS_PASSWORD once Redis apps exist:
#    - REDIS_DATA_DIR holds persistent AOF/RDB files for all app Redis databases.
#    - REDIS_PASSWORD is baked into encrypted REDIS_URL strings stored in apps.
# REDIS_DATA_DIR=/var/lib/explita/redis
# REDIS_PASSWORD=change-me-to-a-secure-redis-password
# REDIS_PORT=6379
# REDIS_USER=default
# REDIS_MAX_DATABASES=256

# ------------------------------------------------------ #
# 2. RUNTIME / ROTATABLE VALUES - SAFE TO TWEAK ANYTIME  #
# ------------------------------------------------------ #

# Server Listen Address (requires service restart to take effect)
PORT=39756
HOST=0.0.0.0

# (Optional) Public domain for the deploy control plane server itself
# When set, explita-caddy automatically terminates SSL/TLS (Let's Encrypt / ZeroSSL)
# and routes https://<domain> to PORT via host gateway, allowing you to access the deploy
# server over https:// without specifying port numbers (e.g. eda config set server https://deploy.mycompany.com).
# DEPLOY_DOMAIN=deploy.example.com

# API / CLI Authentication Bearer Token
# Safe to rotate anytime: independent of APP_ENCRYPTION_KEY.
# After updating here and restarting the deploy server, update your CLI config:
#   eda config set token <new-token>
DEPLOY_TOKEN=change-me

# (Optional) Static PIN / Passcode Protection
# When set, CLI requests must provide matching --pass <pin> (or x-explita-pass header).
# Protects your server if someone inspects or gains access to your local machine's stored token.
# DEPLOY_PASSCODE=12345

# (Optional) Dynamic 2-Factor Authentication (TOTP / Google Authenticator)
# When set, CLI requests must provide a valid 6-digit rotating 2FA code (or enter when prompted).
# Format: Base32 secret key (e.g. from Google Authenticator, 1Password, or openssl).
# DEPLOY_2FA_SECRET=JBSWY3DPEHPK3PXP


# Server Logging (set to true to enable verbose server log output on VPS terminal)
LOG_INFO=false

# Maximum Request Body Size for deployment tarballs, DB restores, and dumps
# Examples: 100MB, 250MB, 500MB, 1GB
MAX_REQUEST_BODY_SIZE=100MB

# Docker Image Retention Limit per application
# Number of past deployment images kept on disk before automatic cleanup
IMAGE_RETENTION_LIMIT=3

# Cron Execution History Limit per application
# Number of past cron execution runs kept in database before automatic pruning
CRON_HISTORY_LIMIT=50

# Managed Redis Container Toggle
REDIS_ENABLED=false

# Explita Tunnel Configuration (Automated public tunnel sidecars)
# Safe to enable, disable, or reconfigure anytime.
# Retrieve or generate your TUNNEL_TOKEN using the unified CLI:
#   explita tunnel token -e <email>     (request OTP & authenticate)
#   explita tunnel token                (print currently saved token)
TUNNEL_ENABLED=false
# TUNNEL_TOKEN=exp_live_...
# TUNNEL_SERVER_URL=wss://tunnel.explita.ng/_connect
# TUNNEL_DOMAIN=tunnel.explita.ng
# TUNNEL_IMAGE=explita/cli:latest

# Server-Wide Default S3 / Cloudflare R2 Storage (Backups & Dumps)
# Fallback object storage configuration for database backups (eda db backup --s3)
# and application dumps (eda dump --s3) when an app does not set its own S3 credentials.
# Supports AWS S3, Cloudflare R2, MinIO, Backblaze B2, Wasabi, etc.
# Individual apps can override this anytime via: eda s3 set -a <appId> [options]
# GLOBAL_S3_ENABLED=false
# GLOBAL_S3_BUCKET=my-backup-bucket
# GLOBAL_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# GLOBAL_S3_ACCESS_KEY_ID=your-s3-access-key-id
# GLOBAL_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# GLOBAL_S3_REGION=auto
# GLOBAL_S3_PREFIX=backups
# GLOBAL_S3_FORCE_PATH_STYLE=false

